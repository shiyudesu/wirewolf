FROM python:3.11-slim

WORKDIR /app

# 安装核心依赖
RUN pip install --no-cache-dir \
    fastapi uvicorn pydantic openai httpx structlog transitions

# 复制代码
COPY backend/app/ ./app/
COPY backend/run_cli.py backend/run_batch.py backend/evaluate.py backend/run_evolution.py ./

ENV PYTHONPATH=/app
ENV LEADERBOARD_DB=/app/data/leaderboard.db

# 创建数据目录
RUN mkdir -p /app/data /app/logs/games

EXPOSE 8000

CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
