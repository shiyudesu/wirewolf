# WireWolf 环境配置
# 复制此文件为 .env 并填入你的实际配置

# ========================== LLM 配置 ==========================
# OpenAI 格式 API Key（必填，使用 LLM 模式时）
LLM_API_KEY=your-api-key-here

# API Base URL（可选，默认 OpenAI 官方）
LLM_BASE_URL=https://api.openai.com/v1

# 默认模型（可选，默认 gpt-4o-mini）
LLM_MODEL=gpt-4o-mini

# ========================== 数据库配置 ==========================
# PostgreSQL 连接 URL（必填）
DATABASE_URL=postgresql+asyncpg://wirewolf:wirewolf@localhost:5433/wirewolf
